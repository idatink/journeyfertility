# Where the enquiry form POSTs. Leave unset in development: the form will then
# report that nothing was sent, rather than showing a false confirmation.
# Supabase edge function: https://<project>.supabase.co/functions/v1/make-server-bb5634ef/enquiries
VITE_ENQUIRY_ENDPOINT=

# --- Server side (set on the edge function, never in the client bundle) ---
# Comma separated origins allowed to post enquiries. A wildcard would let any
# site submit health data from a visitor's browser.
# ALLOWED_ORIGINS=https://journeyfertility.com
#
# Per-clinic API keys for the status endpoint, as JSON:
# CLINIC_API_KEYS={"thames-fertility":"<secret>"}
