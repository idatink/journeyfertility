# --- Client (compiled into the bundle, therefore public) ---

# Where the enquiry form POSTs. The API is now served from the same origin as
# the site, so this is a relative path:
#
#   VITE_ENQUIRY_ENDPOINT=/api/enquiries
#
# Leave it unset until the Blob store exists. The form then reports that nothing
# was sent, rather than showing a confirmation for an enquiry that 500'd. Set it
# deliberately, as the switch that turns the funnel on.
VITE_ENQUIRY_ENDPOINT=

# Never put a secret behind a VITE_ prefix. Anything so prefixed is compiled
# into JavaScript that every visitor downloads.


# --- Server (set in Vercel project settings, not in this file) ---

# Added automatically when you create the Blob store. Do not set it by hand.
# BLOB_READ_WRITE_TOKEN=

# Bearer token for the operator endpoints: listing enquiries, marking them
# forwarded, and triggering the retention sweep by hand.
# ADMIN_KEY=<secret>

# Vercel sends this on scheduled cron invocations, so the retention sweep can
# authenticate without an operator key. Generate a long random value.
# CRON_SECRET=<secret>
